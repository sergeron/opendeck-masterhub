{
  "Name": "Cooler Master MasterHUB",
  "Description": "Unofficial device support for Cooler Master MasterHUB modules (15xKey, 3xKnob, 2xRoller, 1xDial, 5xFader), with lighting, volume, animated GIF, hardware sensor and clock actions",
  "Author": "MasterHUB community",
  "Version": "0.7.2",
  "PluginUUID": "io.github.opendeck-masterhub",
  "CodePathWin": "opendeck-masterhub.exe",
  "Icon": "icon",
  "Category": "MasterHUB",
  "CategoryIcon": "icon",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "linux"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "11"
    }
  ],
  "Actions": [
    {
      "UUID": "io.github.opendeck-masterhub.lighting",
      "Name": "Lighting",
      "Tooltip": "Colour, effect and brightness of the LEDs on the base, knobs and fader",
      "Icon": "icons/lighting",
      "States": [
        {
          "Image": "icons/lighting"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": true,
      "PropertyInspectorPath": "pi/lighting.html"
    },
    {
      "UUID": "io.github.opendeck-masterhub.volume",
      "Name": "Volume",
      "Tooltip": "Fader: slider position = volume. Knobs / rollers / dial: rotate to change, press to mute",
      "Icon": "icons/volume",
      "States": [
        {
          "Image": "icons/volume"
        }
      ],
      "Controllers": [
        "Encoder",
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/volume.html"
    },
    {
      "UUID": "io.github.opendeck-masterhub.gif",
      "Name": "GIF animation",
      "Tooltip": "Animated GIF on a 15xKey key or the dial screen",
      "Icon": "icons/gif",
      "States": [
        {
          "Image": "icons/gif"
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/gif.html"
    },
    {
      "UUID": "io.github.opendeck-masterhub.sensor",
      "Name": "Sensor",
      "Tooltip": "Temperature, load, power, fans… from LibreHardwareMonitor, FPS from RivaTuner",
      "Icon": "icons/sensor",
      "States": [
        {
          "Image": "icons/sensor",
          "TitleAlignment": "middle",
          "FontSize": 14
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/sensor.html"
    },
    {
      "UUID": "io.github.opendeck-masterhub.clock",
      "Name": "Clock",
      "Tooltip": "Time and date – e.g. on the dial's round screen; pressing can open a program, send a shortcut or mute",
      "Icon": "icons/clock",
      "States": [
        {
          "Image": "icons/clock",
          "ShowTitle": false
        }
      ],
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "PropertyInspectorPath": "pi/clock.html"
    }
  ],
  "DeviceNamespace": "mh",
  "CodePathLin": "opendeck-masterhub-linux",
  "CodePathMac": "opendeck-masterhub-mac"
}
